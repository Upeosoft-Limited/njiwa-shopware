{
  "name": "upeo/njiwa-shopware",
  "description": "WhatsApp your customers when their order is paid, shipped or cancelled, through Njiwa.",
  "type": "shopware-platform-plugin",
  "license": "MIT",
  "version": "0.1.0",
  "authors": [
    { "name": "UPEO.AI", "homepage": "https://upeo.ai" }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "shopware/core": "~6.5.0 || ~6.6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5"
  },
  "autoload": {
    "psr-4": { "Upeo\\Njiwa\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Upeo\\Njiwa\\Tests\\": "tests/" }
  },
  "extra": {
    "shopware-plugin-class": "Upeo\\Njiwa\\UpeoNjiwa",
    "copyright": "(c) by UPEO.AI",
    "label": {
      "en-GB": "Njiwa WhatsApp"
    },
    "description": {
      "en-GB": "Message your customers on WhatsApp when their order is paid, shipped, cancelled or refunded, and get a message yourself when one comes in."
    },
    "manufacturerLink": {
      "en-GB": "https://upeo.ai"
    },
    "supportLink": {
      "en-GB": "https://docs.njiwa.upeo.ai"
    }
  }
}
